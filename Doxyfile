# Identificação exibida na página inicial da documentação.
PROJECT_NAME   = "TP1 Kanban"
PROJECT_BRIEF  = "Documentação das classes do projeto TP1 Kanban"

# Cabeçalhos, implementações e instruções do projeto.
INPUT          = include src README.md
FILE_PATTERNS  = *.hpp *.cpp *.md
RECURSIVE      = YES
INPUT_ENCODING = UTF-8
EXCLUDE_PATTERNS = */testes/*

# Usa o README como página principal da documentação.
USE_MDFILE_AS_MAINPAGE = README.md

# Exibe a API documentada e verifica descrições de classes, membros e parâmetros.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# Mantém a saída sob build/ (ignorada pelo Git); a página inicial fica em build/html.
OUTPUT_DIRECTORY = build
GENERATE_HTML    = YES
HTML_OUTPUT      = html
GENERATE_LATEX   = NO
